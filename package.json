{
  "name": "sovanvitou-backend",
  "version": "1.0.0",
  "description": "REST API + static host for the Sovanvitou hospital management app (PostgreSQL, Node 22+)",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "seed": "node --disable-warning=ExperimentalWarning seed.js",
    "migrate": "node --disable-warning=ExperimentalWarning migrate-sqlite-to-pg.js",
    "test": "node --disable-warning=ExperimentalWarning test.js && node --disable-warning=ExperimentalWarning test-ui.js"
  },
  "dependencies": {
    "bwip-js": "^4.11.4",
    "exceljs": "^4.4.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14"
  }
}
