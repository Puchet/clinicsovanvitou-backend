# Copy to .env and edit. Never commit .env.
PORT=3000
HOST=127.0.0.1

# PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/sovanvitou

# Or individual PostgreSQL parameters:
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=sovanvitou
# PGSSL=true # for cloud PostgreSQL (Supabase, Neon, AWS RDS, etc.)

# 32+ random chars. If empty, a secret is generated and stored in the database.
JWT_SECRET=

# Cambodia is UTC+7; used for "today" and the daily report
TZ_OFFSET_HOURS=7

# Only set if the frontend is served from a different origin
CORS_ORIGIN=

# Used by `npm run seed` to create the first admin (optional; you can also use the sign-in page on first run)
ADMIN_EMAIL=
ADMIN_PASSWORD=
